# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
*.pem
*.key

# Data & Datasets (Giữ lại cấu trúc thư mục với .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models & Weights (Trọng số model dung lượng lớn)
models/*.pt
models/*.onnx
models/*.pth
models/*.weights
models/*.h5
models/*.tflite

# Training Runs & Logs
runs/
scratch/
*.log
logs/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Node / Web Frontend
node_modules/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
